---
import BaseLayout from "../layouts/BaseLayout.astro";

type Language = "zh" | "en";

type Experience = {
  org: string;
  role: string;
  period: string;
  logo?: string;
  scene: string;
  method: string;
  result: string;
  tags: string[];
  archive?: {
    slug: string;
    label: string;
    status: string;
  };
};

type FitItem = {
  title: string;
  body: string;
};

type EducationItem = {
  school: string;
  program: string;
  period: string;
  image: string;
  body: string;
  tags: string[];
};

type LifeItem = {
  title: string;
  image: string;
  body: string;
};

type PortfolioPage = {
  lang: Language;
  nav: {
    intro: string;
    education: string;
    internships: string;
    campus: string;
    fit: string;
    life: string;
    contact: string;
  };
  hero: {
    eyebrow: string;
    name: string;
    accent: string;
    role: string;
    school: string;
    email: string;
    keywords: string[];
  };
  education: {
    title: string;
    copy: string;
    items: EducationItem[];
  };
  internships: {
    title: string;
    copy: string;
    labels: {
      scene: string;
      method: string;
      result: string;
    };
    items: Experience[];
  };
  campus: {
    title: string;
    copy: string;
    labels: {
      scene: string;
      method: string;
      result: string;
    };
    items: Experience[];
  };
  fit: {
    title: string;
    copy: string;
    items: FitItem[];
  };
  life: {
    title: string;
    copy: string;
    items: LifeItem[];
  };
  contact: {
    title: string;
    links: Array<{ label: string; href: string }>;
  };
  footer: string;
};

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;

const pages: PortfolioPage[] = [
  {
    lang: "zh",
    nav: {
      intro: "简介",
      education: "教育",
      internships: "实习",
      campus: "校园",
      fit: "匹配",
      life: "生活",
      contact: "联系"
    },
    hero: {
      eyebrow: "PERSONAL PORTFOLIO / STRATEGY, INSIGHT, CONTENT",
      name: "缪",
      accent: "欣怡",
      role: "咨询与商业洞察方向 / 会计学 BBA / 内容与消费观察",
      school: "香港中文大学（深圳）｜会计学 BBA｜2027 届",
      email: "miamiaoxy@outlook.com",
      keywords: ["Analyst", "Observer", "Storyteller"]
    },
    education: {
      title: "Education",
      copy:
        "两段学习经历构成了我的商业基础和国际视角：一段在深圳的经管训练，一段在法国商学院的交换学习。",
      items: [
        {
          school: "CUHK-Shenzhen",
          program: "香港中文大学（深圳）｜会计学 BBA｜2027 届",
          period: "2023 - 2027",
          image: "/images/education-cuhksz.jpg",
          body:
            "在经管学院学习会计与商业基础，也通过新闻社和学院传播工作持续接触校园内容、活动与组织协作。",
          tags: ["Business", "Accounting", "SME"]
        },
        {
          school: "ESSEC Business School",
          program: "交换学习｜Strategy / Luxury Management / Consumer Psychology",
          period: "2025",
          image: "/images/education-essec.jpg",
          body:
            "在 ESSEC 补充战略、奢侈品管理和消费者心理相关课程，把品牌、消费与跨文化语境放在一起观察。",
          tags: ["Strategy", "Luxury", "Consumer"]
        }
      ]
    },
    internships: {
      title: "Internships",
      copy:
        "四段实习都和“理解业务问题、拆解信息、形成判断”有关。我按业务场景、方法和产出呈现，方便快速抓住每段经历的重点。",
      labels: {
        scene: "业务场景",
        method: "方法",
        result: "产出"
      },
      items: [
        {
          org: "Bosch Management Consulting",
          role: "内部咨询实习生",
          period: "2025.12 - Present",
          logo: "/logos/bosch.svg",
          scene: "支持 BSH 全球研发组织变革，推动前沿技术能力向集中式 Tech Hub 重构。",
