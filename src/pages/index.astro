---

<BaseLayout
  title="缪欣怡 - Personal Portfolio"
  description="缪欣怡的个人经历展示页，包含咨询、消费者洞察、内容运营和生活兴趣。"
>
  <div class="site-shell portfolio-shell">
    <header class="topbar">
      <a class="brand" href={withBase("/")}>Xinyi Miao</a>
      <nav class="nav" aria-label="Primary navigation">
        <a href="#intro-zh" data-section-anchor="intro">
          <span data-lang-text="zh">{labels.zh.intro}</span>
          <span data-lang-text="en" hidden>{labels.en.intro}</span>
        </a>
        <a href="#education-zh" data-section-anchor="education">
          <span data-lang-text="zh">{labels.zh.education}</span>
          <span data-lang-text="en" hidden>{labels.en.education}</span>
        </a>
        <a href="#internships-zh" data-section-anchor="internships">
          <span data-lang-text="zh">{labels.zh.internships}</span>
          <span data-lang-text="en" hidden>{labels.en.internships}</span>
        </a>
        <a href="#campus-zh" data-section-anchor="campus">
          <span data-lang-text="zh">{labels.zh.campus}</span>
          <span data-lang-text="en" hidden>{labels.en.campus}</span>
        </a>
        <a href="#fit-zh" data-section-anchor="fit">
          <span data-lang-text="zh">{labels.zh.fit}</span>
          <span data-lang-text="en" hidden>{labels.en.fit}</span>
        </a>
        <a href="#life-zh" data-section-anchor="life">
          <span data-lang-text="zh">{labels.zh.life}</span>
          <span data-lang-text="en" hidden>{labels.en.life}</span>
        </a>
        <a href="#contact-zh" data-section-anchor="contact">
          <span data-lang-text="zh">{labels.zh.contact}</span>
          <span data-lang-text="en" hidden>{labels.en.contact}</span>
        </a>
      </nav>
      <div class="language-toggle" aria-label="Language">
        <button type="button" data-language-button="zh" aria-pressed="true">中</button>
        <button type="button" data-language-button="en" aria-pressed="false">EN</button>
      </div>
    </header>

    {
      pages.map((page) => (
        <main data-lang-panel={page.lang} hidden={page.lang !== "zh"}>
          <section class="hero portfolio-hero" id={`intro-${page.lang}`}>
            <div class="hero-copy">
              <div>
                <p class="eyebrow">{page.hero.eyebrow}</p>
                <h1 class="hero-title portfolio-title">
                  {page.hero.name}<span>{page.hero.accent}</span>
                </h1>
                <p class="hero-role">{page.hero.role}</p>
                <div class="keyword-row" aria-label="Portfolio keywords">
                  {page.hero.keywords.map((keyword) => <span class="keyword-item">{keyword}</span>)}
                </div>
              </div>
              <div class="hero-footer">
                <p>{page.hero.school}</p>
                <a class="button-link" href={`mailto:${page.hero.email}`}>{page.hero.email}</a>
              </div>
            </div>
            <div class="hero-media">
              <img src={withBase("/images/hero-xinyi.jpg")} alt="Xinyi in the mountains" />
            </div>
          </section>

          <section class="section education-section" id={`education-${page.lang}`} aria-labelledby={`education-heading-${page.lang}`}>
            <div class="section-heading">
              <h2 id={`education-heading-${page.lang}`}>{page.education.title}</h2>
              <p class="section-copy">{page.education.copy}</p>
            </div>
            <div class="education-grid">
              {page.education.items.map((item, index) => (
                <article class="education-card">
                  <div class="education-image">
                    <img src={withBase(item.image)} alt={`${item.school} campus`} />
                  </div>
                  <div class="education-body">
                    <span class="education-index">0{index + 1}</span>
                    <p class="archive-meta">{item.period}</p>
                    <h3>{item.school}</h3>
                    <strong>{item.program}</strong>
                    <p>{item.body}</p>
                    <div class="tag-row">
                      {item.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="section internships-section" id={`internships-${page.lang}`} aria-labelledby={`internships-heading-${page.lang}`}>
            <div class="section-heading">
              <h2 id={`internships-heading-${page.lang}`}>{page.internships.title}</h2>
              <p class="section-copy">{page.internships.copy}</p>
            </div>
            <div class="experience-list">
              {page.internships.items.map((item, index) => (
                <article class="experience-entry">
                  <span class="archive-number">0{index + 1}</span>
                  <div class="archive-meta">
                    {item.logo && <img class="experience-logo" src={withBase(item.logo)} alt={`${item.org} logo`} />}
                    <div>{item.period}</div>
                    <div>{item.role}</div>
                  </div>
                  <div class="experience-body">
                    <h3>{item.org}</h3>
                    <dl>
                      <div>
                        <dt>{page.internships.labels.scene}</dt>
                        <dd>{item.scene}</dd>
                      </div>
                      <div>
                        <dt>{page.internships.labels.method}</dt>
                        <dd>{item.method}</dd>
                      </div>
                      <div>
                        <dt>{page.internships.labels.result}</dt>
                        <dd>{item.result}</dd>
                      </div>
                    </dl>
                    <div class="tag-row">
                      {item.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                    {item.archive && (
                      <div class="archive-link-row">
                        <a class="archive-link" href={withBase(`/work/${item.archive.slug}/`)}>
                          {item.archive.label}
                        </a>
                        <span>{item.archive.status}</span>
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="section campus-section" id={`campus-${page.lang}`} aria-labelledby={`campus-heading-${page.lang}`}>
            <div class="section-heading">
              <h2 id={`campus-heading-${page.lang}`}>{page.campus.title}</h2>
              <p class="section-copy">{page.campus.copy}</p>
            </div>
            <div class="experience-list campus-list">
              {page.campus.items.map((item, index) => (
                <article class="experience-entry campus-entry">
                  <span class="archive-number">0{index + 1}</span>
                  <div class="archive-meta">
                    <div>{item.period}</div>
                    <div>{item.role}</div>
                  </div>
                  <div class="experience-body">
                    <h3>{item.org}</h3>
                    <dl>
                      <div>
                        <dt>{page.campus.labels.scene}</dt>
                        <dd>{item.scene}</dd>
                      </div>
                      <div>
                        <dt>{page.campus.labels.method}</dt>
                        <dd>{item.method}</dd>
                      </div>
                      <div>
                        <dt>{page.campus.labels.result}</dt>
                        <dd>{item.result}</dd>
                      </div>
                    </dl>
                    <div class="tag-row">
                      {item.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                    {item.archive && (
                      <div class="archive-link-row">
                        <a class="archive-link" href={withBase(`/work/${item.archive.slug}/`)}>
                          {item.archive.label}
                        </a>
                        <span>{item.archive.status}</span>
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="section fit-section" id={`fit-${page.lang}`} aria-labelledby={`fit-heading-${page.lang}`}>
            <div class="section-heading">
              <h2 id={`fit-heading-${page.lang}`}>{page.fit.title}</h2>
              <div class="fit-heading-content">
                <p class="section-copy">{page.fit.copy}</p>
                <div class="fit-brand" aria-label={page.lang === "zh" ? "小红书" : "Xiaohongshu"}>
                  <img
                    class="fit-logo"
                    src={withBase("/logos/xiaohongshu.png")}
                    alt={page.lang === "zh" ? "小红书 logo" : "Xiaohongshu logo"}
                  />
                </div>
              </div>
            </div>
            <div class="fit-grid">
              {page.fit.items.map((item, index) => (
                <article class="fit-card">
                  <span class="fit-index">0{index + 1}</span>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="section life-section" id={`life-${page.lang}`} aria-labelledby={`life-heading-${page.lang}`}>
            <div class="section-heading">
              <h2 id={`life-heading-${page.lang}`}>{page.life.title}</h2>
              {page.life.copy && <p class="section-copy">{page.life.copy}</p>}
            </div>
            <div class="life-gallery">
              {page.life.items.map((item, index) => (
                <article class="life-item">
                  <img src={withBase(item.image)} alt={item.title} />
                  <div class="life-caption">
                    <span>0{index + 1}</span>
                    <div>
                      <h3>{item.title}</h3>
                      <p>{item.body}</p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="section" id={`contact-${page.lang}`}>
            <div class="contact-panel">
              <h2>{page.contact.title}</h2>
              <div class="contact-links">
                {page.contact.links.map((link) => (
                  <a class="button-link" href={link.href}>{link.label}</a>
                ))}
              </div>
            </div>
          </section>
        </main>
      ))
    }

    <footer class="footer">
      <span>MIAO XINYI</span>
      <span>
        <span data-lang-text="zh">{pages[0].footer}</span>
        <span data-lang-text="en" hidden>{pages[1].footer}</span>
      </span>
    </footer>
  </div>
</BaseLayout>
